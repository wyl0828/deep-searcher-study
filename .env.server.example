# 服务器私有环境文件模板
# 复制为 .env.server 放在服务器 /opt/deepsearcher-study/.env.server 后修改。
# 该文件被 .gitignore 忽略，禁止提交 Git；Provider 密钥只放服务器，不进入镜像。

COMPOSE_PROJECT_NAME=deepsearcher-study

POSTGRES_DB=deepsearcher
POSTGRES_USER=deepsearcher
POSTGRES_PASSWORD=change-this-postgres-password

MINIO_ROOT_USER=deepsearcher
MINIO_ROOT_PASSWORD=change-this-minio-password
DEEPSEARCHER_S3_BUCKET=deepsearcher-documents

DEEPSEARCHER_SERVICE_TOKEN=change-this-service-token
DEEPSEARCHER_ADMIN_TOKEN=change-this-admin-token
DEEPSEARCHER_SESSION_SECRET=change-this-session-secret-at-least-32-bytes

# Provider 凭据只放在服务器 .env.server，不进入 Git 与镜像。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Nginx 接入后允许的 Host 与对外 Origin（逗号分隔；缺省仅 127.0.0.1/localhost）
DEEPSEARCHER_WORKSPACE_ALLOWED_HOSTS=deepsearcher.aimianshi.xyz,118.178.234.18
DEEPSEARCHER_WORKSPACE_PUBLIC_ORIGIN=http://deepsearcher.aimianshi.xyz

# 服务器回环端口（默认值，仅绑定 127.0.0.1，不占用既有 80/3306/6379/8080/2238/4000）
PRODUCT_API_A_SERVER_PORT=18700
PRODUCT_API_B_SERVER_PORT=18701
CORE_API_SERVER_PORT=18702
# Copy to .env.compose before starting the engineering topology.
COMPOSE_PROJECT_NAME=deepsearcher-study

POSTGRES_DB=deepsearcher
POSTGRES_USER=deepsearcher
POSTGRES_PASSWORD=change-this-postgres-password

MINIO_ROOT_USER=deepsearcher
MINIO_ROOT_PASSWORD=change-this-minio-password
DEEPSEARCHER_S3_BUCKET=deepsearcher-documents

DEEPSEARCHER_SERVICE_TOKEN=change-this-service-token
DEEPSEARCHER_ADMIN_TOKEN=change-this-admin-token
DEEPSEARCHER_SESSION_SECRET=change-this-session-secret-at-least-32-bytes

# Provider credentials remain outside the image and repository.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Local host ports are only applied by compose.local.yaml.
PRODUCT_API_A_PORT=8600
PRODUCT_API_B_PORT=8601
CORE_API_PORT=8500
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_GRPC_PORT=8081
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091

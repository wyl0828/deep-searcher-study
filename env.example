# Copy this file to .env and fill in your API keys

# OpenAI API Key (required if using OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek API Key (required if using DeepSeek models)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# SiliconFlow API Key (required if using SiliconFlow models)
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# PPIO API Key (required if using PPIO models)
PPIO_API_KEY=your_ppio_api_key_here

# Jiekou.AI API Key (required if using Jiekou.AI models)
JIEKOU_API_KEY=your_jiekouai_api_key_here

# Together AI API Key (required if using Together AI models)
TOGETHER_API_KEY=your_together_api_key_here

# XAI API Key (required if using XAI Grok models)
XAI_API_KEY=your_xai_api_key_here

# Anthropic API Key (required if using Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gemini API Key (required if using Gemini models)
GEMINI_API_KEY=your_gemini_api_key_here

# Voyage API Key (required if using Voyage embeddings)
VOYAGE_API_KEY=your_voyage_api_key_here

# FireCrawl API Key (required if using web crawling features)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Aliyun Bailian API Key (required if using Qwen models from Aliyun)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Azure OpenAI Configuration (required if using Azure OpenAI)
AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint_here
AZURE_OPENAI_KEY=your_azure_openai_key_here

# AWS Credentials (required if using AWS Bedrock)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Novita API Key (required if using Novita models)
NOVITA_API_KEY=your_novita_api_key_here

# GLM API Key (required if using GLM models)
GLM_API_KEY=your_glm_api_key_here

# Volcengine API Key (required if using Volcengine models)
VOLCENGINE_API_KEY=your_volcengine_api_key_here

# Request-scoped runtime and tenant isolation
DEEPSEARCHER_DEFAULT_TENANT=local
DEEPSEARCHER_PRODUCT_TENANT=local
DEEPSEARCHER_SERVICE_TOKEN=replace_with_a_random_service_token
DEEPSEARCHER_ADMIN_TOKEN=replace_with_a_random_admin_token
# Per-process query admission limit. Set to 0 only for isolated development.
DEEPSEARCHER_QUERY_RATE_LIMIT=60
DEEPSEARCHER_QUERY_RATE_WINDOW_SECONDS=60
# Real dependency probe timeout and paid provider diagnostic cache duration.
DEEPSEARCHER_HEALTH_PROBE_TIMEOUT_SECONDS=8
DEEPSEARCHER_HEALTH_PROVIDER_CACHE_SECONDS=300
# CORS is disabled by default. Use comma-separated exact http(s) origins; wildcards are ignored.
# DEEPSEARCHER_CORS_ORIGINS=https://workspace.example.com
# User workspace accepts loopback Host values by default. When using a trusted reverse proxy,
# add its public hostname and declare the single browser-facing origin explicitly.
# DEEPSEARCHER_WORKSPACE_ALLOWED_HOSTS=workspace.example.com
# DEEPSEARCHER_WORKSPACE_PUBLIC_ORIGIN=https://workspace.example.com
# Optional; defaults to data/runtime/deepsearcher-runtime.db
# DEEPSEARCHER_RUNTIME_DB=D:/path/to/deepsearcher-runtime.db
# Product database. SQLite is the local default. PostgreSQL deployments must run
# `python -m alembic upgrade head` before startup; the service only validates its schema.
# DEEPSEARCHER_DATABASE_URL=postgresql+psycopg://deepsearcher:password@127.0.0.1:5432/deepsearcher
# Optional destructive integration-test database; the test recreates its public schema.
# DEEPSEARCHER_TEST_POSTGRES_URL=postgresql+psycopg://deepsearcher:password@127.0.0.1:5432/deepsearcher_test
# Product PDF upload and durable ingestion limits.
DEEPSEARCHER_MAX_PDF_BYTES=20971520
DEEPSEARCHER_MAX_PDF_PAGES=500
DEEPSEARCHER_MAX_DOCUMENTS_PER_KNOWLEDGE_BASE=200
DEEPSEARCHER_KNOWLEDGE_BASE_STORAGE_QUOTA_BYTES=536870912
DEEPSEARCHER_TOTAL_STORAGE_QUOTA_BYTES=2147483648
DEEPSEARCHER_PDF_PROBE_TIMEOUT_SECONDS=10
DEEPSEARCHER_INGEST_REQUEST_TIMEOUT_SECONDS=300
DEEPSEARCHER_INGEST_LEASE_SECONDS=360
DEEPSEARCHER_INGEST_MAX_RETRIES=3
DEEPSEARCHER_INGEST_RETRY_BASE_SECONDS=5
# Optional Web search. Queries leave the local system only when the user enables
# Web search for an individual question.
TAVILY_API_KEY=
